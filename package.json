{
  "name": "emoji-datasource-openmoji",
  "version": "1.1.0",
  "description": "OpenMoji emoji images compatible with emoji-datasource: 128px per-emoji WebP files plus 32/64px sprite sheets. Drop-in replacement for emoji-datasource-apple/google/twitter.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js"
  },
  "keywords": [
    "emoji",
    "openmoji",
    "sprite",
    "spritesheet",
    "emoji-datasource",
    "unicode"
  ],
  "author": "Alex G",
  "license": "CC-BY-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pure-Karma-Labs/emoji-datasource-openmoji.git"
  },
  "homepage": "https://github.com/Pure-Karma-Labs/emoji-datasource-openmoji#readme",
  "bugs": {
    "url": "https://github.com/Pure-Karma-Labs/emoji-datasource-openmoji/issues"
  },
  "peerDependencies": {
    "emoji-datasource": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "emoji-datasource": {
      "optional": true
    }
  },
  "devDependencies": {
    "emoji-datasource": "^16.0.0",
    "openmoji": "^17.0.0",
    "sharp": "^0.35.5"
  },
  "files": [
    "img/",
    "index.js",
    "README.md",
    "LICENSE"
  ]
}
